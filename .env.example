# ============================================
# AI Agents Platform - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# Application Settings
# ============================================
# Application name displayed in API docs
APP_NAME=AI Agents Platform

# Application version
APP_VERSION=1.0.0

# Environment: development | staging | production
ENVIRONMENT=development

# Enable debug mode (set to false in production)
DEBUG=true

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ============================================
# Server Configuration
# ============================================
# Host to bind the server to
HOST=0.0.0.0

# Port to run the server on
PORT=8000

# Number of worker processes (increase in production)
WORKERS=1

# ============================================
# OpenAI Configuration (Primary LLM Provider)
# ============================================
# Your OpenAI API key
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI API base URL (change for Azure OpenAI or proxies)
OPENAI_API_BASE=https://api.openai.com/v1

# Model to use for chat completions
# Options: gpt-4o, gpt-4-turbo, gpt-3.5-turbo, etc.
OPENAI_MODEL=gpt-4o

# Model to use for embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# Google Gemini Configuration (Fallback LLM Provider)
# ============================================
# Your Google AI API key
# Get it from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Gemini model to use
# Options: gemini-1.5-pro, gemini-1.5-flash, gemini-pro
GEMINI_MODEL=gemini-1.5-pro

# ============================================
# MongoDB Configuration
# ============================================
# MongoDB connection URI
# For Docker: mongodb://mongodb:27017
# For local: mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017

# Database name for the application
MONGODB_DATABASE=ai_agents

# Collection for storing user sessions
MONGODB_SESSIONS_COLLECTION=sessions

# Collection for LangGraph workflow checkpoints
MONGODB_CHECKPOINTS_COLLECTION=checkpoints

# ============================================
# Pinecone Configuration (Vector Store)
# ============================================
# Your Pinecone API key
# Get it from: https://app.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key-here

# Pinecone environment (e.g., us-east-1-aws)
PINECONE_ENVIRONMENT=us-east-1-aws

# Name of the Pinecone index to use
PINECONE_INDEX_NAME=ai-agents

# ============================================
# Circuit Breaker Configuration
# ============================================
# Maximum number of failures before circuit opens
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30

# ============================================
# MCP (Model Context Protocol) Configuration
# ============================================
MCP_ACTIVE=true
MCP_TRANSPORT=both
MCP_SSE_PORT=8001
MCP_SERVER_NAME=ai-agents-mcp5

# ============================================
# LLMGuard Configuration (Prompt Security)
# ============================================
# Enable/disable LLMGuard sanitization
LLMGUARD_ENABLED=true

# Risk score threshold (0.0 - 1.0)
# Lower values are more strict
LLMGUARD_RISK_THRESHOLD=0.7

# ============================================
# Session Configuration
# ============================================
# Session time-to-live in hours
SESSION_TTL_HOURS=24

# ============================================
# Docker Compose Overrides
# ============================================
# Port mappings for Docker services
APP_PORT=8000
MONGODB_PORT=27017
MONGO_EXPRESS_PORT=8081

# Mongo Express credentials (dev only)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin
